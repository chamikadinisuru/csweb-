# ==============================================================================
# North Western Provincial Council - Chief Secretariat Web Portal
# Environment Configuration Template (DevOps / Container 12-Factor Standard)
# ==============================================================================

# Application Environment (production / staging / development)
APP_ENV=production
APP_DEBUG=false

# Database Configuration
# In Docker Compose, DB_HOST should match the db service name ("db")
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=csweb_db
DB_USER=root
DB_PASS=

# Production Database Credentials (set these in cloud/server deployment):
# DB_HOST=db
# DB_PORT=3306
# DB_NAME=csweb_db
# DB_USER=csweb_user
# DB_PASS=YourSecureStrongPasswordHere2026!

# External Web Listening Port (for Docker Compose)
WEB_PORT=80

